{
  "name": "dsh-codex-bridge",
  "displayName": "Codex 会话桥接",
  "description": "打通 Codex 会话与 DeepSeek Harness 的数据互转，支持双向导入导出（含子代理会话、工具调用与元数据）。",
  "version": "0.1.0",
  "author": "admin",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "session-import-export",
    "migration"
  ],
  "type": "module",
  "engines": {
    "dsh": "0.2.1-rc.2",
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "assets",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.1",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:client": "node scripts/build-client.mjs"
  },
  "icon": "./assets/icon.svg",
  "license": "MIT"
}
